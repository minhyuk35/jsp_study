<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hatshop</groupId>
    <artifactId>HatShop</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>HatShop</name>
    <description>JSP/Servlet 기반 모자 쇼핑몰</description>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>

        <!-- ─────────────────────────────────────────
             Servlet 4.0 / JSP 2.3 API (Tomcat 9 제공)
        ───────────────────────────────────────── -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- ─────────────────────────────────────────
             JSTL 1.2
        ───────────────────────────────────────── -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- ─────────────────────────────────────────
             MySQL Connector/J 8.x
        ───────────────────────────────────────── -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
        </dependency>

        <!-- ─────────────────────────────────────────
             jBCrypt 0.4 — 비밀번호 해싱
        ───────────────────────────────────────── -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!--
        ┌─────────────────────────────────────────────────────────────┐
        │  cos.jar (O'Reilly MultipartRequest — 파일 업로드)           │
        │  Maven Central에 없으므로 아래 두 방법 중 하나를 선택하세요.   │
        │                                                               │
        │  방법 A — 로컬 저장소에 수동 설치 후 아래 주석 해제:           │
        │    mvn install:install-file                                   │
        │      -Dfile=/path/to/cos.jar                                  │
        │      -DgroupId=com.oreilly                                    │
        │      -DartifactId=cos                                         │
        │      -Dversion=05Nov2002                                      │
        │      -Dpackaging=jar                                          │
        │                                                               │
        │  방법 B — WEB-INF/lib/ 에 cos.jar 직접 복사 (Maven 불필요)    │
        └─────────────────────────────────────────────────────────────┘
        <dependency>
            <groupId>com.oreilly</groupId>
            <artifactId>cos</artifactId>
            <version>05Nov2002</version>
        </dependency>
        -->

    </dependencies>

    <build>
        <finalName>hatshop</finalName>
        <resources>
            <!-- db.properties → WEB-INF/classes/ 자동 복사 -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>db.properties</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Java 11 컴파일 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- WAR 패키징 — war 이름: hatshop.war -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warName>hatshop</warName>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Tomcat 9 인플레이스 실행 (개발용) -->
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <port>8080</port>
                    <path>/hatshop</path>
                    <uriEncoding>UTF-8</uriEncoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
